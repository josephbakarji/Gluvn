{
  "contract_version": "2.0.0-draft.1",
  "status": "implemented opt-in prototype; physical validation and complete main-profile metadata pending",
  "wire_version": 2,
  "sample_kind": 1,
  "byte_order": ">",
  "sync_hex": "a65a",
  "length_bytes": 1,
  "crc": {"name": "CRC-16/CCITT-FALSE", "polynomial": 4129, "initial": 65535, "xorout": 0, "reflect": false, "coverage": "payload"},
  "sample_fields": [
    {"name": "version", "code": "B", "count": 1, "unit": "version"},
    {"name": "kind", "code": "B", "count": 1, "unit": "record kind"},
    {"name": "hand", "code": "B", "count": 1, "unit": "ASCII l/r"},
    {"name": "status", "code": "H", "count": 1, "unit": "bit mask"},
    {"name": "frame_seq", "code": "I", "count": 1, "unit": "scheduled output tick count"},
    {"name": "imu_seq", "code": "I", "count": 1, "unit": "successful driver-read count"},
    {"name": "imu_read_us", "code": "I", "count": 1, "unit": "device us"},
    {"name": "frame_us", "code": "I", "count": 1, "unit": "device us at end of finger scan"},
    {"name": "nav_epoch", "code": "H", "count": 1, "unit": "navigation reset count"},
    {"name": "calibration_epoch", "code": "H", "count": 1, "unit": "applied calibration revision count"},
    {"name": "finger_scan_span_us", "code": "H", "count": 1, "unit": "us; 65535 means overflow/unknown"},
    {"name": "imu_dt_us", "code": "I", "count": 1, "unit": "us since previous successful driver read; 0 without a fresh read"},
    {"name": "accel_pre_g", "code": "f", "count": 3, "unit": "g; sensor frame before configured bias subtraction"},
    {"name": "gyro_pre_dps", "code": "f", "count": 3, "unit": "deg/s; sensor frame before active startup bias subtraction"},
    {"name": "accel_input_g", "code": "f", "count": 3, "unit": "g; actual pre-filter input passed to both estimators"},
    {"name": "gyro_input_dps", "code": "f", "count": 3, "unit": "deg/s; actual pre-filter input passed to both estimators"},
    {"name": "q_mahony_wxyz", "code": "f", "count": 4, "unit": "dimensionless; world-from-sensor, Mahony world"},
    {"name": "q_nav_wxyz", "code": "f", "count": 4, "unit": "dimensionless; world-from-sensor, navigation world"},
    {"name": "velocity_nav_mps", "code": "f", "count": 3, "unit": "m/s; navigation world"},
    {"name": "position_nav_m", "code": "f", "count": 3, "unit": "m; IMU origin in navigation world since reset"},
    {"name": "lin_accel_nav_mps2", "code": "f", "count": 3, "unit": "m/s2; navigation world, gravity removed by NavEKF"},
    {"name": "zupt_mahalanobis", "code": "f", "count": 1, "unit": "dimensionless squared distance; -1 means never evaluated"},
    {"name": "flex_raw", "code": "H", "count": 5, "unit": "ADC counts, 0..4095"},
    {"name": "press_raw", "code": "H", "count": 5, "unit": "ADC counts, 0..4095"},
    {"name": "sensor_saturation_mask", "code": "B", "count": 1, "unit": "bits ax/ay/az/gx/gy/gz; 255 means unavailable"}
  ],
  "status_bits": {
    "imu_fresh": 0, "imu_raw_finite": 1, "imu_dt_valid": 2,
    "mahony_stepped": 3, "nav_update_called": 4, "nav_armed": 5,
    "nav_zupt_active": 6, "nav_zupt_starved": 7, "sync_led": 8,
    "low_battery": 9, "mahony_output_finite": 10, "nav_output_finite": 11
  },
  "control_header_format": ">BBBIHHI",
  "control_kinds": {"metadata": 2, "event": 3, "metrics": 4},
