    "att_mtu": 128, "cameras": 2, "camera_width": 1280, "camera_height": 720,
    "camera_channels": 3, "camera_fps": 30.0, "camera_queue_frames": 15,
    "firmware_tx_queue_frames": 4, "host_log_queue_records": 1024,
    "host_log_queue_byte_cap": 2097152, "raw_max_chunk_bytes": 4096,
    "camera_queue_byte_cap_per_camera": 67108864, "live_queue_frames": 2, "duration_s": 600.0
  }
}
